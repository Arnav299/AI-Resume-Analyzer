# =============================================================================
# backend/.env.example — Copy to .env and fill in your values
# =============================================================================
APP_NAME=AI Resume Analyzer
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_resume_analyzer
DATABASE_ECHO=False

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File uploads
UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_SIZE_MB=10

# CORS Origins (comma-separated JSON list)
CORS_ORIGINS=["htt","http://127.0.0.1:5173"]
